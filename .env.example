# Feedbackspinne - Umgebungsvariablen (Beispiel-Vorlage)
# Kopiere diese Datei zu .env und fülle die echten Werte ein

# Datenbank-Konfiguration
DB_HOST=localhost
DB_NAME=deine_datenbank
DB_USER=dein_benutzer
DB_PASS=dein_passwort

# Sicherheit - Generiere einen zufälligen String (z.B. mit: openssl rand -base64 32)
SECURE_KEY=generiere_einen_zufaelligen_string_hier

# Debug-Modus (false in Produktion, true nur lokal)
DEBUG_MODE=false

# ── Benutzer-Authentifizierung ─────────────────────────────────────────────
# App-URL (ohne abschließenden Slash) – wird für Reset-Links verwendet
APP_URL=https://deine-domain.de

# SMTP-Konfiguration für E-Mail-Versand (PHPMailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dein-smtp-user@example.com
SMTP_PASS=dein-smtp-passwort
SMTP_FROM_EMAIL=noreply@deine-domain.de
SMTP_FROM_NAME=Feedbackspinne
